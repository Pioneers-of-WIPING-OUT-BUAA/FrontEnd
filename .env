# 项目通用配置 =======================================

# API 基础地址 (后端接口)
VITE_API_BASE_URL=http://10.212.30.237:8000/api

# 是否为开发模式 (true/false)
VITE_IS_DEV=true

# 是否启用 SSR (服务端渲染) (true/false)
VITE_SERVER=false

# Vue Router 模式 (hash/history/abstract)
VITE_VUE_ROUTER_MODE=history

# Vue Router Base 路径 (一般为 / 或子路径)
VITE_VUE_ROUTER_BASE=/

# 机器人连接最大重试次数
VITE_ROS_MAX_RETRIES=10

# 主题色 (Element Plus)
VITE_THEME_COLOR=#409EFF

# 项目版本号
VITE_PROJECT_VERSION=1.0.0

# 自定义 Key（示例用途）
VITE_CUSTOM_KEY=114514

# 调试开关
VITE_DEBUG=true
